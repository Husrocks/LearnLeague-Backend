{
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py",
      "headers": {
        "Access-Control-Allow-Origin": "https://learn-league-platform.vercel.app",
        "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Authorization, Content-Type, x-request-id",
        "Access-Control-Allow-Credentials": "true"
      }
    }
  ],
  "crons": [
    {
      "path": "/cron/streaks",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/weekly-winner",
      "schedule": "0 0 * * 0"
    }
  ]
}
